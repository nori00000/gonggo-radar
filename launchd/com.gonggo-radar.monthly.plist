<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  월간 종합호 잡 (P1' 계약 §2) — **초안이며 로드하지 않는다.**
  로드는 사람(또는 Fable)이 판단한다: `launchctl bootstrap gui/$(id -u) <경로>`.

  launchd 는 "매월 첫째 목요일"을 직접 표현하지 못한다. 그래서 이 plist 는
  **매주 목요일 23:00**(Weekday=4) 에 깨우고, scripts/monthly_job.sh 가
  `date +%d` 가 1~7 일 때만 진행한다(그 주 목요일 = 그 달의 첫째 목요일).
  나머지 주는 로그 한 줄을 남기고 exit 0 이다.

  같은 시각의 com.gonggo-radar.digest(주간호)와 **다른 호 키**를 쓰므로
  digests/ 의 lock·state·items.json 이 겹치지 않는다 (계약 §1).
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONPATH</key>
		<string>/Users/leesangmin/gonggo-radar</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.gonggo-radar.monthly</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/leesangmin/gonggo-radar/scripts/monthly_job.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/leesangmin/Library/Logs/gonggo-radar/monthly.log</string>
	<key>StandardOutPath</key>
	<string>/Users/leesangmin/Library/Logs/gonggo-radar/monthly.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>23</integer>
			<key>Minute</key>
			<integer>0</integer>
			<key>Weekday</key>
			<integer>4</integer>
		</dict>
	</array>
	<key>ThrottleInterval</key>
	<integer>300</integer>
	<key>WorkingDirectory</key>
	<string>/Users/leesangmin/gonggo-radar</string>
</dict>
</plist>
