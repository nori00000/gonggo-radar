# ============================================================================
# agrion-automation alert system - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# Telegram Configuration
# ----------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram to get these values
# 1. Chat with @BotFather and create a new bot
# 2. Get your bot token
# 3. Start a chat with your bot
# 4. Visit https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates to find your chat_id

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ----------------------------------------------------------------------------
# Email Configuration
# ----------------------------------------------------------------------------
# For Gmail, you need to:
# 1. Enable 2-factor authentication
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use the app password here (not your regular password)

EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# ----------------------------------------------------------------------------
# Claude API (Anthropic)
# ----------------------------------------------------------------------------
# Get your API key from https://console.anthropic.com/settings/keys
# Optional: The system works with keyword-only analysis if not provided

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----------------------------------------------------------------------------
# Bizinfo API
# ----------------------------------------------------------------------------
# Get your API key from https://www.bizinfo.go.kr
# 1. Register at Bizinfo
# 2. Request Open API access
# 3. Copy your service key

BIZINFO_API_KEY=your_bizinfo_api_key_here

# ----------------------------------------------------------------------------
# 공공데이터포털 API (data.go.kr)
# ----------------------------------------------------------------------------
# Get your API key from https://www.data.go.kr
# 1. Register at data.go.kr
# 2. Search for the service and request access (활용신청)
# 3. Copy your service key from MyPage (마이페이지)
# Used by: G2B (나라장터), K-Startup (창업지원사업)

DATA_GO_KR_API_KEY=your_data_go_kr_api_key_here

# ----------------------------------------------------------------------------
# Additional Crawler APIs (if needed)
# ----------------------------------------------------------------------------
# Add additional API keys for other crawlers as they are implemented

# MAFRA_API_KEY=your_mafra_api_key_here
# SMARTFARM_API_KEY=your_smartfarm_api_key_here
# GOYANG_API_KEY=your_goyang_api_key_here
# NONGSARO_API_KEY=your_nongsaro_api_key_here

# ----------------------------------------------------------------------------
# Knowledge Layer (optional)
# ----------------------------------------------------------------------------
# OpenAI API key for vector embeddings (text-embedding-3-small)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Obsidian vault path for automatic note sync
# Example: /Users/leesangmin/Documents/Obsidian-0.1
OBSIDIAN_VAULT_PATH=

# n8n webhook URL for workflow integration (disabled by default)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/agrion

# ----------------------------------------------------------------------------
# Database Configuration (optional)
# ----------------------------------------------------------------------------
# Leave empty to use SQLite (default)
# Set to PostgreSQL URL to use PostgreSQL backend
# Format: postgresql://username:password@host:port/database
# Example: postgresql://agrion:password@localhost:5432/agrion_db
# DATABASE_URL=
